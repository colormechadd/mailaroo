package templates

templ Layout(title string, csrfToken string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } - MAILAROO</title>
			<meta name="csrf-token" content={ csrfToken }/>
			<link rel="icon" type="image/png" href="/static/img/favicon.png"/>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="https://unpkg.com/htmx-ext-sse@2.2.2/sse.js"></script>
			<script defer src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js"></script>
			<link rel="stylesheet" type="text/css" href="https://unpkg.com/trix@2.0.8/dist/trix.css"/>
  			<script type="text/javascript" src="https://unpkg.com/trix@2.0.8/dist/trix.umd.min.js"></script>
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.css"/>
  			<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/codemirror.min.js"></script>
  			<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.18/mode/css/css.min.js"></script>
			<style>
				[x-cloak] { display: none !important; }
				.refresh-btn.htmx-request svg { animation: spin 0.8s linear infinite; }
				@keyframes spin { to { transform: rotate(360deg); } }
				trix-toolbar [data-trix-button-group="file-tools"] { display: none !important; }
				trix-editor {
					min-height: 300px !important;
					border: none !important;
					padding: 1.5rem !important;
					outline: none !important;
				}
				trix-toolbar {
					border-bottom: 1px solid #f3e8ff !important;
					padding-top: 0.5rem !important;
					padding-bottom: 0.5rem !important;
				}
			</style>
			<script>
				function formatLocalTimes() {
					document.querySelectorAll('[data-local-time]').forEach(el => {
						const date = new Date(el.getAttribute('data-local-time'));
						const format = el.getAttribute('data-format') || 'short';

						let options = {
							hour: 'numeric',
							minute: '2-digit',
							hour12: true
						};

						if (format === 'full') {
							options = {
								weekday: 'long',
								year: 'numeric',
								month: 'long',
								day: 'numeric',
								hour: 'numeric',
								minute: '2-digit',
								hour12: true
							};
						} else if (format === 'list') {
							options = {
								month: 'short',
								day: 'numeric',
								hour: 'numeric',
								minute: '2-digit',
								hour12: true
							};
						}

						el.textContent = new Intl.DateTimeFormat('default', options).format(date);
						el.removeAttribute('data-local-time'); // Prevent re-processing
					});
				}

				document.addEventListener('DOMContentLoaded', formatLocalTimes);
				document.addEventListener('htmx:afterSettle', formatLocalTimes);

				document.addEventListener('htmx:afterHistoryRestore', function() {
					const path = window.location.pathname;
					const mailboxMatch = path.match(/^\/mailbox\/([0-9a-f-]{36})/);
					if (mailboxMatch) {
						htmx.ajax('GET', path + window.location.search, { target: '#main-content', swap: 'innerHTML' });
					}
				});

				document.addEventListener('htmx:configRequest', function(evt) {
                    // Ensure the latest token is always pulled from the meta tag
                    evt.detail.headers['X-CSRF-Token'] = document.querySelector('meta[name="csrf-token"]').content;
                });

                document.addEventListener('htmx:afterRequest', function(evt) {
                    // If the server sent a new token in the response header, update the meta tag
                    let newToken = evt.detail.xhr.getResponseHeader("X-CSRF-Token");
                    if (newToken) {
                        document.querySelector('meta[name="csrf-token"]').content = newToken;
                    }
                });
				function initCSSEditors() {
					document.querySelectorAll('textarea[data-css-editor]').forEach(function(ta) {
						if (ta.nextElementSibling && ta.nextElementSibling.classList.contains('CodeMirror')) return;
						const editor = CodeMirror.fromTextArea(ta, {
							mode: 'text/css',
							lineNumbers: true,
							extraKeys: {'Ctrl-S': function() { ta.closest('form').querySelector('[type="submit"]')?.click(); }}
						});
						const cm = editor.getWrapperElement();
						cm.style.height = '120px';
						editor.setSize(null, '120px');
						editor.on('change', function() { editor.save(); ta.dispatchEvent(new Event('input', { bubbles: true })); });
					});
				}
				document.addEventListener('DOMContentLoaded', initCSSEditors);
				document.addEventListener('htmx:afterSettle', initCSSEditors);

				document.addEventListener('htmx:afterSettle', function() {
					const path = window.location.pathname;
					const params = new URLSearchParams(window.location.search);
					const mailboxMatch = path.match(/^\/mailbox\/([0-9a-f-]{36})(\/(.+))?/);
					if (mailboxMatch) {
						const mailboxID = mailboxMatch[1];
						const sub = mailboxMatch[3] || '';
						const filter = sub.startsWith('filters') ? 'filters' : (params.get('filter') || 'unread');
						window.dispatchEvent(new CustomEvent('nav-update', { detail: { mailboxID, filter } }));
					} else if (path.startsWith('/contacts')) {
						window.dispatchEvent(new CustomEvent('nav-update', { detail: { filter: 'contacts' } }));
					}
				});
			</script>
		</head>
		<body class="h-full bg-gray-50 text-gray-900 font-sans antialiased">
			{ children... }
		</body>
	</html>
}
