package templates

import (
	"github.com/colormechadd/mailaroo/pkg/models"
)

templ UserInfo(user *models.User, mailboxes []models.Mailbox, sendingAddresses []models.SendingAddress, sessions []models.WebmailSession) {
	<div class="flex-1 flex flex-col min-h-0 bg-gray-50">
		<!-- Header -->
		<div class="bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between">
			<div class="flex items-center">
				<div class="h-10 w-10 rounded-full bg-teal-500 flex items-center justify-center text-white font-bold text-lg uppercase shadow-sm">
					{ user.Username[:1] }
				</div>
				<div class="ml-4">
					<h1 class="text-xl font-bold text-gray-900">{ user.Username }</h1>
					<p class="text-sm text-gray-500">User Settings</p>
				</div>
			</div>
			<button class="text-gray-400 hover:text-gray-600 transition-colors cursor-pointer p-2 hover:bg-gray-100 rounded-full" @click="htmx.ajax('GET', '/mailbox/' + currentMailboxID + '?filter=' + filter, {target: '#main-content', swap: 'innerHTML', pushUrl: '/mailbox/' + currentMailboxID + '?filter=' + filter})" title="Close">
				<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>

		<!-- Content -->
		<div class="flex-1 overflow-y-auto p-6">
			<div class="max-w-4xl mx-auto space-y-8">
				<!-- Mailboxes -->
				<section>
					<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						Mailboxes
					</h2>
					<div class="bg-white shadow rounded-lg divide-y divide-gray-200">
						for _, mb := range mailboxes {
							<div class="p-4">
								<h3 class="font-medium text-gray-900">{ mb.Name }</h3>
								<div class="mt-4 space-y-4">
									<h4 class="text-xs font-semibold text-gray-500 uppercase tracking-wider">Sending Addresses</h4>
									<div class="grid grid-cols-1 gap-4">
										for _, sa := range sendingAddresses {
											if sa.MailboxID == mb.ID {
												<div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg border border-gray-100 group">
													<div class="flex-1">
														<div class="flex items-center">
															<span class="text-sm font-medium text-gray-900">{ sa.Address }</span>
														</div>
														<div class="mt-1">
															<form
																hx-post={ "/user/sending-address/" + sa.ID.String() + "/display-name" }
																hx-swap="none"
																class="flex items-center"
																x-data="{ saved: false }"
																@htmx:after-request.camel="if ($event.detail.successful) { saved = true; setTimeout(() => saved = false, 2000) }"
															>
																<input
																	type="text"
																	name="display_name"
																	placeholder="Display Name (e.g. Chad Haynes)"
																	value={ getDisplayName(sa.DisplayName) }
																	class="text-xs border-b border-transparent hover:border-gray-300 focus:border-purple-500 focus:outline-none bg-transparent py-1 w-full transition-colors"
																/>
																<button
																	type="submit"
																	class="ml-2 text-xs font-medium transition-all cursor-pointer whitespace-nowrap"
																	:class="saved ? 'text-green-600' : 'text-purple-600 hover:text-purple-800 opacity-0 group-hover:opacity-100'"
																>
																	<span x-show="!saved">Save</span>
																	<span x-show="saved" x-cloak>Saved!</span>
																</button>
															</form>
														</div>
													</div>
												</div>
											}
										}
									</div>
								</div>
							</div>
						}
					</div>
				</section>

					<!-- Change Password -->
				<section>
					<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
						</svg>
						Change Password
					</h2>
					<div class="bg-white shadow rounded-lg p-4">
						<form
							hx-post="/user/change-password"
							hx-target="#change-password-message"
							hx-swap="innerHTML"
							class="space-y-4"
						>
							<div id="change-password-message"></div>
							<div>
								<label for="current_password" class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
								<input
									id="current_password"
									name="current_password"
									type="password"
									required
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all"
								/>
							</div>
							<div>
								<label for="new_password" class="block text-sm font-medium text-gray-700 mb-1">New Password</label>
								<input
									id="new_password"
									name="new_password"
									type="password"
									required
									minlength="8"
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all"
									placeholder="At least 8 characters"
								/>
							</div>
							<div>
								<label for="confirm_password" class="block text-sm font-medium text-gray-700 mb-1">Confirm New Password</label>
								<input
									id="confirm_password"
									name="confirm_password"
									type="password"
									required
									minlength="8"
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all"
									placeholder="Re-enter new password"
								/>
							</div>
							<div>
								<button type="submit" class="px-4 py-2 text-sm font-bold rounded-lg text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-all shadow-md hover:shadow-lg active:scale-[0.98] cursor-pointer">
									Update Password
								</button>
							</div>
						</form>
					</div>
				</section>

				<!-- Two-Factor Authentication -->
					<section>
						<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
								<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
							</svg>
							Two-Factor Authentication
						</h2>
						<div class="bg-white shadow rounded-lg p-4">
							<div id="totp-section">
								if user.TOTPEnabled {
									@TOTPEnabledSection("")
								} else {
									@TOTPDisabledFragment("")
								}
							</div>
						</div>
					</section>
				<!-- Recovery Email -->
				<section>
					<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						Recovery Email
					</h2>
					<div class="bg-white shadow rounded-lg p-4">
						<p class="text-sm text-gray-500 mb-4">Used to receive password reset links.</p>
						<form
							hx-post="/user/recovery-email"
							hx-target="#recovery-email-message"
							hx-swap="innerHTML"
							class="space-y-4"
						>
							<div id="recovery-email-message"></div>
							<div>
								<label for="recovery_email" class="block text-sm font-medium text-gray-700 mb-1">Recovery Email</label>
								<input
									id="recovery_email"
									name="recovery_email"
									type="email"
									value={ user.RecoveryEmail }
									placeholder="me@example.com"
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all"
								/>
							</div>
							<div>
								<label for="recovery_email_password" class="block text-sm font-medium text-gray-700 mb-1">Current Password</label>
								<input
									id="recovery_email_password"
									name="current_password"
									type="password"
									required
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all"
								/>
							</div>
							<div>
								<button type="submit" class="px-4 py-2 text-sm font-bold rounded-lg text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-all shadow-md hover:shadow-lg active:scale-[0.98] cursor-pointer">
									Save Recovery Email
								</button>
							</div>
						</form>
					</div>
				</section>

				<!-- Custom CSS -->
				<section>
					<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
						</svg>
						Custom CSS
					</h2>
					<div class="bg-white shadow rounded-lg p-4">
						<p class="text-sm text-gray-500 mb-4">Add custom CSS to style the email reader. Changes apply immediately.</p>
						<form
							hx-post="/user/custom-css"
							hx-target="#custom-css-message"
							hx-swap="innerHTML"
							class="space-y-4"
						>
							<div id="custom-css-message"></div>
							<div>
								<label for="custom_css" class="block text-sm font-medium text-gray-700 mb-1">CSS</label>
								<textarea
									id="custom_css"
									name="custom_css"
									data-css-editor
									rows="3"
									class="appearance-none block w-full px-3 py-2 border border-gray-300 placeholder-gray-400 text-gray-900 rounded-lg focus:outline-none focus:ring-2 focus:ring-teal-500 focus:border-teal-500 sm:text-sm transition-all font-mono"
									placeholder={ `img { height: auto !important; }` }
								>{ user.CustomCSS }</textarea>
							</div>
							<div>
								<button type="submit" class="px-4 py-2 text-sm font-bold rounded-lg text-white bg-purple-600 hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-teal-500 transition-all shadow-md hover:shadow-lg active:scale-[0.98] cursor-pointer">
									Save Custom CSS
								</button>
							</div>
						</form>
					</div>
				</section>

				<!-- Active Sessions -->
				<section>
					<h2 class="text-lg font-semibold text-gray-900 mb-4 flex items-center">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
						</svg>
						Active Sessions
					</h2>
					@SessionsList(sessions)
				</section>

				</div>
		</div>
	</div>
}

templ ChangePasswordMessage(msg string, isError bool) {
	if isError {
		<div class="text-sm p-3 rounded-md bg-red-50 text-red-700 border border-red-200" role="alert">
			{ msg }
		</div>
	} else {
		<div class="text-sm p-3 rounded-md bg-green-50 text-green-700 border border-green-200" role="alert">
			{ msg }
		</div>
	}
}

templ SessionsList(sessions []models.WebmailSession) {
	<div id="sessions-section" class="bg-white shadow rounded-lg overflow-hidden">
		if len(sessions) == 0 {
			<div class="p-4 text-sm text-gray-400">No active sessions.</div>
		} else {
			<div class="divide-y divide-gray-100">
				for _, s := range sessions {
					<div class="px-4 py-3 flex items-center justify-between">
						<div class="flex-1 min-w-0">
							<div class="flex items-center gap-2">
								<span class="text-sm font-medium text-gray-900">
									if s.RemoteIP != nil {
										{ *s.RemoteIP }
									} else {
										Unknown IP
									}
								</span>
								<span class="text-xs text-gray-400">{ s.CreateDatetime.Format("Jan 2, 2006 3:04 PM") }</span>
							</div>
							if s.UserAgent != nil {
								<p class="text-xs text-gray-400 truncate mt-0.5">{ *s.UserAgent }</p>
							}
						</div>
						<form
							hx-post={ "/user/sessions/" + s.ID.String() + "/cancel" }
							hx-target="#sessions-section"
							hx-swap="innerHTML"
							class="ml-4"
						>
							<button type="submit" class="text-xs font-medium text-red-500 hover:text-red-700 transition-colors cursor-pointer" onclick="return confirm('Cancel this session?')">Cancel</button>
						</form>
					</div>
				}
			</div>
		}
	</div>
}

func getDisplayName(dn *string) string {
	if dn == nil {
		return ""
	}
	return *dn
}
